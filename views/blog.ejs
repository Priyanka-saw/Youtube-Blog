<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('./partials/head') %>
  <title><%= blog.title %></title>
</head>

<body>
  <%- include('./partials/nav') %>

  <div class="container mt-4">
    <h1><%= blog.title %></h1>

    <% 
      let imageUrl = blog.coverImageURL || '/images/default.png';
      if (imageUrl.startsWith('/public/')) {
          imageUrl = imageUrl.replace(/^\/public/, '');
      }
    %>

    <img src="<%= imageUrl %>" width="300" alt="Cover image" class="img-fluid rounded" />

    <pre><%= blog.body %></pre>

    <!-- Show author details -->
    <div class="mt-3">
      <img src="<%= blog.createdBy.profileImageURL || '/images/default.png' %>" 
           width="60px" 
           class="rounded-circle" 
           alt="Author image" />
      <strong><%= blog.createdBy.fullname %></strong>
    </div>

    <!--  Delete button (only visible to owner) -->
    <% if (user && blog.createdBy && user._id.toString() === blog.createdBy._id.toString()) { %>
      <form action="/blog/delete/<%= blog._id %>" method="POST" style="margin-top: 15px;">
        <button 
          type="submit" 
          class="btn btn-danger"
          onclick="return confirm('Are you sure you want to delete this blog?');">
           Delete
        </button>
      </form>
    <% } %>
  </div>

  <div class="container mt-4">
    <h2>Comments (<%= comments.length %>)</h2>

    <% if (locals.user) { %>
      <form action="/blog/comment/<%= blog._id %>" method="POST">
        <div class="mb-3">
          <label for="body" class="form-label">Add a comment</label>
          <input 
            type="text"
            class="form-control"
            id="body"
            name="body"
            required
          />
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
      </form>
    <% } %>

    <div class="mt-3">
      <% comments.forEach(comment => { %>
        <div style="margin-bottom: 10px;">
          <img src="<%= comment.createdBy.profileImageURL || '/images/default.png' %>" 
               width="30px" 
               class="rounded-circle" 
               alt="Commenter image" />
          <strong><%= comment.createdBy.fullname %>:</strong>
          <p><%= comment.body %></p>
        </div>
      <% }); %>
    </div>
  </div>

  <%- include('./partials/scripts') %>
</body>
</html>
